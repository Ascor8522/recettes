{
  "name": "recettes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "pnpm build && wrangler deploy",
    "check": "oxlint src vite.config.ts && oxfmt --check src vite.config.ts package.json tsconfig.json wrangler.jsonc pnpm-workspace.yaml README.md AGENTS.md .vscode && tsc --noEmit",
    "format": "oxfmt --write src vite.config.ts package.json tsconfig.json wrangler.jsonc pnpm-workspace.yaml README.md AGENTS.md .vscode"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.6",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0"
}
